<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RouteOuverte.Pages.EnregistrePage" Title="Signalement enregistré"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource RoBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Border BackgroundColor="{StaticResource RoPrimary}" Stroke="Transparent"
                    WidthRequest="96" HeightRequest="96" HorizontalOptions="Center" Margin="0,16,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="48" />
                </Border.StrokeShape>
                <Label Text="☁" TextColor="White" FontSize="52" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Text="Signalement enregistré" Style="{StaticResource Titre}" HorizontalOptions="Center" />
            <Label Text="Il sera envoyé dès le retour du réseau." Style="{StaticResource Secondaire}" HorizontalOptions="Center" />

            <Border Style="{StaticResource Carte}" Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                    <Border Grid.ColumnSpan="2" BackgroundColor="#ECEFF1" Stroke="Transparent" Padding="10,4" HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Label Text="● En attente d'envoi" FontSize="14" TextColor="{StaticResource RoTextSecondary}" />
                    </Border>

                    <Label Grid.Row="1" Text="Route" Style="{StaticResource Secondaire}" />
                    <Label x:Name="RouteLabel" Grid.Row="1" Grid.Column="1" FontAttributes="Bold" />

                    <Label Grid.Row="2" Text="État" Style="{StaticResource Secondaire}" VerticalOptions="Center" />
                    <Border x:Name="EtatBadge" Grid.Row="2" Grid.Column="1" Stroke="Transparent" Padding="10,4" HorizontalOptions="End">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Label x:Name="EtatLabel" FontSize="14" FontAttributes="Bold" />
                    </Border>

                    <Label Grid.Row="3" Text="Zone" Style="{StaticResource Secondaire}" />
                    <Label x:Name="ZoneLabel" Grid.Row="3" Grid.Column="1" FontAttributes="Bold" />

                    <Label Grid.Row="4" Text="Photo" Style="{StaticResource Secondaire}" />
                    <Label x:Name="PhotoLabel" Grid.Row="4" Grid.Column="1" FontAttributes="Bold" />
                </Grid>
            </Border>

            <Border BackgroundColor="#ECEFF1" Stroke="Transparent" Padding="16,12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Label Text="ℹ Envoi automatique dès que la connexion est rétablie. Valable 6 h." FontSize="14"
                       TextColor="{StaticResource RoTextSecondary}" />
            </Border>

            <Button Text="Voir l'état du jour" Style="{StaticResource BoutonPrincipal}" Margin="0,8,0,0" Clicked="OnVoirEtat" />
            <Button Text="Signaler une autre route" Style="{StaticResource BoutonContour}" Clicked="OnAutreRoute" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>