<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RouteOuverte.Pages.LieuPage" Title="Choisir un lieu"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource RoBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <Border Style="{StaticResource Carte}" Padding="16,0">
                <Entry x:Name="Recherche" Placeholder="🔍  Rechercher un lieu ou un quartier"
                       FontSize="16" TextChanged="OnRecherche" />
            </Border>
            <VerticalStackLayout x:Name="Contenu" Spacing="4" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>