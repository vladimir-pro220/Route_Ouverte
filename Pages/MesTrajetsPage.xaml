<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:RouteOuverte.Models"
             xmlns:v="clr-namespace:RouteOuverte.Views"
             x:Class="RouteOuverte.Pages.MesTrajetsPage" Title="Mes trajets"
             BackgroundColor="{StaticResource RoBackground}">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">
                <Label Text="Enregistrez jusqu'à 3 trajets du quotidien." Style="{StaticResource Secondaire}" />

                <VerticalStackLayout x:Name="Liste" Spacing="16">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:Trajet">
                            <Border Style="{StaticResource Carte}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTrajetTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Nom}" FontAttributes="Bold" VerticalOptions="Center" />
                                        <Border Grid.Column="1" BackgroundColor="{Binding Couleur}" Stroke="Transparent" Padding="10,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Resume}" FontSize="14" FontAttributes="Bold"
                                                   TextColor="{Binding CouleurTexte}" />
                                        </Border>
                                    </Grid>
                                    <Label Text="{Binding MiseAJour}" Style="{StaticResource Secondaire}" />
                                    <Label Text="Signalements valables 6 h" Style="{StaticResource Secondaire}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border Style="{StaticResource Carte}" BackgroundColor="White" Stroke="#C3C6D2"
                        StrokeThickness="2" StrokeDashArray="4,4" Padding="20">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAjouter" />
                    </Border.GestureRecognizers>
                    <Label Text="+ Ajouter un trajet" FontAttributes="Bold" TextColor="{StaticResource RoPrimary}"
                           HorizontalOptions="Center" />
                </Border>

                <!-- Notification (écrans 04 et 21) -->
                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Notification chaque matin" FontAttributes="Bold" VerticalOptions="Center" />
                            <Switch x:Name="NotifSwitch" Grid.Column="1" OnColor="{StaticResource RoPrimary}" Toggled="OnNotifChange" />
                        </Grid>
                        <Label x:Name="NotifTexte" Style="{StaticResource Secondaire}" />

                        <Border x:Name="HeureZone" StrokeThickness="0" BackgroundColor="Transparent" Padding="0,8"
                                MinimumHeightRequest="48" HorizontalOptions="Start">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHeure" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="🕕" VerticalOptions="Center" />
                                <Label x:Name="HeureLabel" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border StrokeThickness="0" BackgroundColor="Transparent" Padding="0,8" MinimumHeightRequest="48">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnApercu" />
                            </Border.GestureRecognizers>
                            <Label Text="Voir l'aperçu de la notification  ›" TextColor="{StaticResource RoPrimary}" FontAttributes="Bold" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Écran 19 : limite atteinte -->
        <v:Dialogue x:Name="Limite" IsVisible="False" />
        <!-- Écran 22 : choisir l'heure -->
        <v:HeureDialog x:Name="Heure" IsVisible="False" />
    </Grid>
</ContentPage>