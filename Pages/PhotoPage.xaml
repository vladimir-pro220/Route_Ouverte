<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RouteOuverte.Pages.PhotoPage"
             Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False"
             BackgroundColor="Black">
    <Grid RowDefinitions="Auto,*,Auto">
        <Button Text="✕" BackgroundColor="Transparent" TextColor="White" FontSize="28"
                HorizontalOptions="Start" WidthRequest="64" HeightRequest="64" Padding="0"
                SemanticProperties.Description="Fermer" Clicked="OnFermer" />
        <Image x:Name="Photo" Grid.Row="1" Aspect="AspectFit" />
        <Label x:Name="Legende" Grid.Row="2" TextColor="White" FontSize="14" FontAttributes="Bold" Padding="16,12,16,24" />
    </Grid>
</ContentPage>