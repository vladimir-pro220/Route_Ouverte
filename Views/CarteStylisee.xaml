<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RouteOuverte.Views.CarteStylisee">
    <Border x:Name="Fond" BackgroundColor="#E8EEF4" Stroke="Transparent" StrokeThickness="0" Padding="16,12">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTap" />
        </Border.GestureRecognizers>
        <Grid x:Name="Trace" ColumnDefinitions="*,*,*" RowDefinitions="*,Auto" />
    </Border>
</ContentView>