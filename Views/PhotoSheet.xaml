<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RouteOuverte.Views.PhotoSheet">
    <Grid>
        <BoxView Color="Black" Opacity="0.2">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAnnuler" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border VerticalOptions="End" BackgroundColor="White" Stroke="Transparent" Padding="16,12,16,16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="12">
                <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2" Color="#C3C6D2" HorizontalOptions="Center" />
                <Label Text="Ajouter une photo" Style="{StaticResource Titre}" FontSize="20" />

                <Border Style="{StaticResource Carte}" Padding="16,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrendre" />
                    </Border.GestureRecognizers>
                    <Label Text="📷   Prendre une photo" FontAttributes="Bold" />
                </Border>

                <Border Style="{StaticResource Carte}" Padding="16,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGalerie" />
                    </Border.GestureRecognizers>
                    <Label Text="🖼   Choisir dans la galerie" FontAttributes="Bold" />
                </Border>

                <Button Text="Annuler" Style="{StaticResource BoutonContour}" Clicked="OnAnnuler" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>